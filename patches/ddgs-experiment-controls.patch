+"""Isolated implementation corrections and opt-in training diagnostics.
+
+Defaults preserve upstream depth/density behaviour. Corrections are not a new
+research method. No random draws are made here.
+"""
+import json
+import os
+from pathlib import Path
+
+import torch
+
+
+def camera_depths(xyz, camera, mode):
+    if mode == 'euclidean':
+        return torch.linalg.vector_norm(xyz-camera.camera_center, dim=1)
+    ones = torch.ones((xyz.shape[0], 1), device=xyz.device)
+    homogeneous = torch.cat([xyz, ones], dim=1)
+    if mode == 'upstream':
+        return (homogeneous @ camera.world_view_transform.T)[:, 2]
+    if mode == 'camera_z':
+        return (homogeneous @ camera.world_view_transform)[:, 2]
+    raise ValueError(f'Unknown DDGS_DEPTH_MODE: {mode}')
+
+
+def ensure_density(owner, mode):
+    if mode not in ('upstream', 'refresh'):
+        raise ValueError(f'Unknown DDGS_DENSITY_MODE: {mode}')
+    dirty = (getattr(owner, '_density_topology_version', -1) !=
+             getattr(owner, '_ddgs_topology_version', 0))
+    dirty = dirty or owner.density_score.numel() != len(owner.get_xyz)
+    if mode == 'refresh' and dirty:
+        owner.update_density_score()
+        return True
+    return False
+
+
+@torch.no_grad()
+def log_diagnostics(owner, camera, iteration, depth_mode, density_mode, refreshed):
+    path = os.environ.get('DDGS_DIAGNOSTICS')
+    if not path:
+        return
+    row = {'iteration': int(iteration), 'camera': camera.image_name,
+           'points': len(owner.get_xyz), 'density_entries': owner.density_score.numel(),
+           'topology_version': getattr(owner, '_ddgs_topology_version', 0),
+           'density_version': getattr(owner, '_density_topology_version', -1),
+           'density_refreshed_before_render': refreshed,
+           'depth_mode': depth_mode, 'density_mode': density_mode}
+    row['density_length_fallback'] = row['density_entries'] < row['points']
+    row['density_topology_stale'] = row['topology_version'] != row['density_version']
+    if iteration == 1 or iteration % 100 == 1 or iteration % 500 == 0:
+        depths = {mode: camera_depths(owner.get_xyz, camera, mode)
+                  for mode in ('upstream', 'camera_z', 'euclidean')}
+        def band(z):
+            s = z.sort().values
+            return (z>s[int(len(s)*.33)]).int()+(z>s[int(len(s)*.67)]).int()
+        a = band(depths['upstream'])
+        row['depth_band_disagreement_z'] = float((a!=band(depths['camera_z'])).float().mean())
+        row['depth_band_disagreement_euclidean'] = float((a!=band(depths['euclidean'])).float().mean())
+    if not hasattr(owner, '_ddgs_diagnostic_file'):
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+        owner._ddgs_diagnostic_file = open(path, 'x', buffering=1)
+    owner._ddgs_diagnostic_file.write(json.dumps(row)+'\n')
