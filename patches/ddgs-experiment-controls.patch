+"""Experimental local stratified dropout, not an established novel method.
+
+Each point retains its original Bernoulli marginal probability. Nearby points
+share a random phase with evenly spaced offsets, reducing local count variance.
+Morton ordering approximates locality; it is not semantic object segmentation.
+"""
+import torch
+
+
+@torch.no_grad()
+def morton_order(xyz):
+    low=xyz.amin(dim=0)
+    span=(xyz.amax(dim=0)-low).clamp_min(1e-6)
+    q=((xyz-low)/span*1023).clamp(0,1023).long()
+    code=torch.zeros(len(xyz),device=xyz.device,dtype=torch.long)
+    for bit in range(10):
+        for axis in range(3):
+            code |= ((q[:,axis] >> bit) & 1) << (3*bit+axis)
+    return torch.argsort(code,stable=True)
+
+
+@torch.no_grad()
+def stratified_keep_mask(keep_prob,order,group_size=8):
+    n=len(keep_prob)
+    rank=torch.arange(n,device=keep_prob.device)
+    group=rank//group_size
+    sizes=(n-group*group_size).clamp(max=group_size)
+    phase=torch.rand((int((n+group_size-1)//group_size),),device=keep_prob.device)
+    u=(phase[group]+(rank%group_size)/sizes)%1
+    mask=torch.empty_like(keep_prob)
+    mask[order]=(u<keep_prob[order]).to(keep_prob.dtype)
+    return mask
+
+
+@torch.no_grad()
+def spatial_keep_mask(keep_prob,xyz,owner,iteration):
+    cache=getattr(owner,'_spatial_dropout_cache',None)
+    if cache is None or cache[0]!=len(xyz) or iteration-cache[1]>=500:
+        cache=(len(xyz),iteration,morton_order(xyz.detach()))
+        owner._spatial_dropout_cache=cache
+    return stratified_keep_mask(keep_prob,cache[2])
